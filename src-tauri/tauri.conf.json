{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "The Fawn’s Story",
  "mainBinaryName": "TheFawnsStory",
  "version": "1.0.0",
  "identifier": "com.fawngard.thefawnsstory",
  "build": {
    "frontendDist": "../dist/web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "The Fawn’s Story",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "maximized": true,
        "resizable": true,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$RESOURCE/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Kive's Sane",
    "copyright": "© Kive's Sane",
    "shortDescription": "The Fawn’s Story — Season 1: Bloody Tour",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../dist/media/audio/": "audio/",
      "../dist/media/video/": "video/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
